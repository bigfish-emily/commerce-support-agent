flowchart TB
    I["1. 已通过参数、权限和归属检查"] --> J{"2. SQLite 写入占位<br/>是否创建成功？"}
    J -->|"已有未核对记录"| U["结果未知：禁止自动重放"]
    J -->|"创建成功"| L{"3. 获取配置的短租约锁"}
    L -->|"锁占用"| B["返回正在执行"]
    L -->|"获锁 / 未配置锁"| X["4. 执行一次业务写调用"]
    X -->|"成功"| S["5. 保留业务事件与幂等结果<br/>移除写入占位"]
    X -->|"异常 / 超时"| Q["5. 保留结果未知占位<br/>停止自动重试"]
    Q --> U
    S --> O["6. 审计并返回真实执行状态"]
    B --> O
    U --> O
